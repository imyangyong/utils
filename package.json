{
  "name": "@imyangyong/utils",
  "type": "module",
  "version": "9.6.0",
  "packageManager": "pnpm@11.24.0",
  "description": "Opinionated collection of common JavaScript / TypeScript utils",
  "author": "Angus Yang <imyangyong@foxmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/imyangyong/utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imyangyong/utils.git"
  },
  "bugs": {
    "url": "https://github.com/imyangyong/utils/issues"
  },
  "keywords": [
    "utils"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs"
  },
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "lint-fix": "nr lint --fix",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "p-limit": "^7.3.1",
    "p-map": "^7.0.6",
    "until-async": "^3.0.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@antfu/ni": "^30.5.0",
    "@types/node": "^26.3.0",
    "@types/throttle-debounce": "^5.0.2",
    "bumpp": "^12.2.1",
    "eslint": "^10.9.1",
    "p-limit": "^7.3.1",
    "throttle-debounce": "5.0.2",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
